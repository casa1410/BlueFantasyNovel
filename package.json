{
  "name": "bluefantasynovel",
  "productName": "BlueFantasyNovel",
  "version": "0.5.1",
  "description": "Estudio de escritura gratuito y sin conexión para novelistas: manuscrito, personajes y worldbuilding en tu ordenador.",
  "license": "Unlicense",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.bluefantasynovel.app",
    "productName": "BlueFantasyNovel",
    "copyright": "Dominio público (The Unlicense)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlueFantasyNovel",
      "artifactName": "BlueFantasyNovel-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BlueFantasyNovel-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "docx": "^9.8.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
